{
  "id": "/",
  "name": "TailoraHub",
  "short_name": "TailoraHub",
  "description": "A premium tailoring marketplace for customers, tailors and platform admins.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "theme_color": "#0b0d10",
  "background_color": "#050606",
  "categories": ["business", "shopping", "lifestyle"],
  "lang": "en-IN",
  "dir": "ltr",
  "icons": [
    {
      "src": "https://tailorahub-assets.s3.eu-north-1.amazonaws.com/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://tailorahub-assets.s3.eu-north-1.amazonaws.com/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://tailorahub-assets.s3.eu-north-1.amazonaws.com/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Customer booking",
      "short_name": "Customer",
      "description": "Open TailoraHub customer booking.",
      "url": "/?role=customer&source=pwa-shortcut",
      "icons": [{ "src": "https://tailorahub-assets.s3.eu-north-1.amazonaws.com/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Tailor dashboard",
      "short_name": "Tailor",
      "description": "Open TailoraHub tailor operations.",
      "url": "/?role=tailor&source=pwa-shortcut",
      "icons": [{ "src": "https://tailorahub-assets.s3.eu-north-1.amazonaws.com/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
