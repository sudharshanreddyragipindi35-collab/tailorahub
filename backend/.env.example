# ==== APP / LOCAL DEV ====
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_SLOW_QUERY_MS=500
REDIS_URL=
ACCESS_TOKEN_MINUTES=
SESSION_INACTIVITY_MINUTES=15
CORS_ORIGINS=
AUTO_MIGRATE=
APP_ENV=development

# ==== STATELESS MEDIA STORAGE ====
# Use local only for development. Production backend containers should use s3.
MEDIA_STORAGE_BACKEND=local
S3_MEDIA_BUCKET=
S3_MEDIA_REGION=ap-south-1
S3_MEDIA_ENDPOINT_URL=
S3_MEDIA_KEY_PREFIX=media
CLOUDFRONT_MEDIA_BASE_URL=
S3_PRESIGN_TTL_SECONDS=300

# ==== SHARED REAL-TIME EVENTS ====
# Use redis in production so every backend task receives booking events.
REALTIME_BACKPLANE=local
REALTIME_CHANNEL_PREFIX=tailorahub:booking
REALTIME_TICKET_SECONDS=120

# ==== PHASE 4 BACKGROUND SERVICES ====
# web, worker, scheduler, or migration
SERVICE_ROLE=web
# inline for local development; sqs for production
TASK_QUEUE_BACKEND=inline
SQS_TASK_QUEUE_URL=
SQS_TASK_DLQ_URL=
SQS_REGION=ap-south-1
SQS_ENDPOINT_URL=
TASK_MAX_ATTEMPTS=5
TASK_VISIBILITY_TIMEOUT_SECONDS=60
TASK_LONG_POLL_SECONDS=20

# ==== AUTH / SECURITY ====
JWT_SECRET=
JWT_REFRESH_SECRET=
AADHAAR_ENCRYPTION_KEY=

# ==== ADMIN BOOTSTRAP ====
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PHONE=
# Comma-separated public egress IP/CIDR values allowed to use admin login and APIs.
# Example: ADMIN_ALLOWED_NETWORKS=203.0.113.25/32
ADMIN_ALLOWED_NETWORKS=
# Only these direct reverse proxies may supply X-Forwarded-For client addresses.
ADMIN_TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128

# ==== SMS OTP GATEWAY (mobile number verification) ====
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE_ID=
SMS_API_BASE_URL=

# ==== EMAIL OTP / VERIFICATION / NOTIFICATIONS ====
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
AWS_SES_REGION=ap-south-1

# Optional SMTP compatibility for EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_STARTTLS=
SMTP_USER=
SMTP_PASS=
EMAIL_OUTBOX=

# ==== AADHAAR eKYC VERIFICATION ====
AADHAAR_KYC_PROVIDER=
AADHAAR_KYC_API_KEY=
AADHAAR_KYC_API_SECRET=
AADHAAR_KYC_BASE_URL=

# ==== PAYMENT GATEWAY (Razorpay test/live mode) ====
PAYMENT_PROVIDER=razorpay
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMIN_PAYMENT_UPI_ID=
ADMIN_PAYMENT_QR_URL=
MANUAL_PAYMENT_EXPIRY_MINUTES=5
PAYOUT_API_KEY=
PAYOUT_API_SECRET=

# ==== MAPS (location picker, Uber/Rapido-style) ====
MAPS_PROVIDER=
MAPS_API_KEY=
