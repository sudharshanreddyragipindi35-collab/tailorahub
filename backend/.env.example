# ==== APP / LOCAL DEV ====
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_SLOW_QUERY_MS=500
REDIS_URL=
ACCESS_TOKEN_MINUTES=
SESSION_INACTIVITY_MINUTES=15
EXPOSE_DEV_OTP=false
CORS_ORIGINS=
PUBLIC_WEB_URL=https://tailorahub.com
AUTO_MIGRATE=
APP_ENV=development
LOG_LEVEL=INFO
CLOUDWATCH_EMF_ENABLED=false
# Local-only sample data and credential note. Production must set both false.
ENABLE_DEMO_DATA=true
WRITE_ADMIN_CREDENTIAL_FILE=true

# ==== STATELESS MEDIA STORAGE ====
# Use local only for development. Production backend containers should use s3.
MEDIA_STORAGE_BACKEND=local
S3_MEDIA_BUCKET=
S3_MEDIA_REGION=ap-south-1
S3_MEDIA_ENDPOINT_URL=
S3_MEDIA_KEY_PREFIX=media
CLOUDFRONT_MEDIA_BASE_URL=
S3_PRESIGN_TTL_SECONDS=300

# ==== SHARED REAL-TIME EVENTS ====
# Use redis in production so every backend task receives booking events.
REALTIME_BACKPLANE=local
REALTIME_CHANNEL_PREFIX=tailorahub:booking
REALTIME_TICKET_SECONDS=120

# ==== PHASE 4 BACKGROUND SERVICES ====
# web, worker, scheduler, or migration
SERVICE_ROLE=web
# inline for local development; sqs for production
TASK_QUEUE_BACKEND=inline
SQS_TASK_QUEUE_URL=
SQS_TASK_DLQ_URL=
SQS_REGION=ap-south-1
SQS_ENDPOINT_URL=
TASK_MAX_ATTEMPTS=5
TASK_VISIBILITY_TIMEOUT_SECONDS=60
TASK_LONG_POLL_SECONDS=20

# ==== PHASE 5 CACHE AND TRAFFIC PROTECTION ====
# memory is development-only; production must use the shared Redis/Valkey endpoint.
TRAFFIC_STORE_BACKEND=memory
PUBLIC_CACHE_TTL_SECONDS=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_OTP_PER_MINUTE=5
RATE_LIMIT_PAYMENT_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_WEBHOOK_PER_MINUTE=1000
MAX_REQUEST_BODY_BYTES=2097152
MAX_UPLOAD_REQUEST_BYTES=26214400
# In production include only the ALB/VPC proxy CIDRs that may set X-Forwarded-For.
CLIENT_IP_TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128

# ==== PHASE 6 EXTERNAL PROVIDER FAILURE ISOLATION ====
EXTERNAL_CONNECT_TIMEOUT_SECONDS=5
EXTERNAL_RESPONSE_TIMEOUT_SECONDS=15
EXTERNAL_SAFE_RETRY_ATTEMPTS=3
EXTERNAL_RETRY_BASE_MS=250
EXTERNAL_CIRCUIT_FAILURE_THRESHOLD=5
EXTERNAL_CIRCUIT_RESET_SECONDS=30

# ==== AUTH / SECURITY ====
# Production values must be unique, non-placeholder secrets supplied at runtime.
JWT_SECRET=
JWT_REFRESH_SECRET=
AADHAAR_ENCRYPTION_KEY=

# ==== ADMIN BOOTSTRAP ====
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PHONE=
# Comma-separated public egress IP/CIDR values allowed to use admin login and APIs.
# Example: ADMIN_ALLOWED_NETWORKS=203.0.113.25/32
ADMIN_ALLOWED_NETWORKS=
# Only these direct reverse proxies may supply X-Forwarded-For client addresses.
ADMIN_TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128

# ==== SMS OTP GATEWAY (mobile number verification) ====
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE_ID=
SMS_API_BASE_URL=

# ==== EMAIL OTP / VERIFICATION / NOTIFICATIONS ====
AWS_SECRETS_MANAGER_SECRET_ID=
AWS_SECRETS_MANAGER_REGION=eu-north-1
# Use email while SMS/Msg91 is not configured; set to auto after enabling SMS.
AUTH_OTP_CHANNEL=email
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
# Use a verified mailbox/alias. Keep SMTP_USER/SMTP_PASS in a secret store.
EMAIL_FROM_ADDRESS=TailoraHub <noreply@tailorahub.com>
EMAIL_FROM_DEFAULT=TailoraHub <noreply@tailorahub.com>
EMAIL_FROM_VERIFY=TailoraHub Verify <verify@tailorahub.com>
EMAIL_FROM_BOOKINGS=TailoraHub Bookings <bookings@tailorahub.com>
EMAIL_FROM_SUPPORT=TailoraHub Support <support@tailorahub.com>
EMAIL_FROM_PAYMENTS=TailoraHub Payments <payments@tailorahub.com>
EMAIL_FROM_ADMIN=TailoraHub Admin <admin@tailorahub.com>
EMAIL_REPLY_TO=
AWS_SES_REGION=ap-south-1

# Optional SMTP compatibility for EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=sudharshan.r@tailorahub.com
SMTP_PASS=
EMAIL_OUTBOX=

# ==== AADHAAR eKYC VERIFICATION ====
AADHAAR_KYC_PROVIDER=
AADHAAR_KYC_API_KEY=
AADHAAR_KYC_API_SECRET=
AADHAAR_KYC_BASE_URL=

# ==== PAYMENT GATEWAY (Razorpay test/live mode) ====
PAYMENT_PROVIDER=razorpay
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMIN_PAYMENT_UPI_ID=
ADMIN_PAYMENT_QR_URL=
MANUAL_PAYMENT_EXPIRY_MINUTES=5
PAYOUT_API_KEY=
PAYOUT_API_SECRET=

# ==== MAPS (location picker, Uber/Rapido-style) ====
MAPS_PROVIDER=
MAPS_API_KEY=
